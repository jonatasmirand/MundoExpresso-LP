# EmailJS Configuration
# Para configurar o formulário de contato, siga estes passos:
# 1. Crie uma conta gratuita em https://www.emailjs.com/
# 2. Adicione um serviço de email (recomendado: Gmail)
# 3. Crie um template de email com as variáveis: {{from_name}}, {{phone}}, {{cargo}}, {{to_email}}
# 4. Copie as chaves abaixo e substitua os valores

VITE_EMAILJS_PUBLIC_KEY=sua_public_key_aqui
VITE_EMAILJS_SERVICE_ID=seu_service_id_aqui
VITE_EMAILJS_TEMPLATE_ID=seu_template_id_aqui
